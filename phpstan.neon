includes:
    - vendor/larastan/larastan/extension.neon
    # Once you've generated a baseline, uncomment:
    # - phpstan-baseline.neon

parameters:
    level: 5

    # Models declare casts() with an `@return array<string, string>` docblock,
    # which hides the real keys from Larastan. Parse the method body instead.
    parseModelCastsMethod: true

    paths:
        - app
        - bootstrap/app.php
        - config
        - database
        - routes

    # Nova custom tools/fields live in nova-components/ as separate path
    # packages, so they're deliberately not analysed here.

    # Raise one level at a time (5 -> 6 -> 7...) once the baseline is clean.
    # treatPhpDocTypesAsCertain: false   # uncomment if PHPDoc types cause noise

    ignoreErrors:
        # Blueprint macros added by Nova field packages (nova-sortable, etc.).
        -
            message: '#Call to an undefined method Illuminate\\Database\\Schema\\ColumnDefinition::(sortable|hideOnIndex)\(\)#'
            path: database/migrations/*
        # Colours sampled here are always RGB; red()/green()/blue() live on the
        # RGB implementation, not on Intervention's ColorInterface.
        -
            message: '#Call to an undefined method Intervention\\Image\\Interfaces\\ColorInterface::(red|green|blue)\(\)#'
            path: app/Services/Images/ListingThumbnail.php
