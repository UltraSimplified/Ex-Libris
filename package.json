{
    "$schema": "https://www.schemastore.org/package.json",
    "private": true,
    "type": "module",
    "scripts": {
        "build": "vite build",
        "build:ssr": "vite build && vite build --ssr",
        "dev": "vite",
        "format": "prettier --write resources/",
        "format:check": "prettier --check resources/",
        "lint": "eslint . --fix",
        "typecheck": "vue-tsc --noEmit",
        "build-writers": "cd nova-components/Writers && npm run dev",
        "build-writers-prod": "cd nova-components/Writers && npm run prod",
        "build:nova-gallery": "vite build --config nova-components/Gallery/vite.config.js",
        "build:nova-video-embed": "vite build --config nova-components/VideoEmbed/vite.config.js"
    },
    "devDependencies": {
        "@eslint/js": "^9.19.0",
        "@laravel/vite-plugin-wayfinder": "^0.1.3",
        "@tailwindcss/forms": "^0.5.11",
        "@tailwindcss/vite": "^4.3.0",
        "@types/leaflet": "^1.9.20",
        "@types/node": "^22.13.5",
        "@vitejs/plugin-vue": "^6.0.0",
        "@vue/eslint-config-typescript": "^14.3.0",
        "autoprefixer": "^10.4.24",
        "concurrently": "^9.0.1",
        "eslint": "^9.17.0",
        "eslint-config-prettier": "^10.0.1",
        "eslint-import-resolver-typescript": "^4.4.4",
        "eslint-plugin-import": "^2.32.0",
        "eslint-plugin-vue": "^9.32.0",
        "postcss": "^8.5.6",
        "prettier": "^3.4.2",
        "prettier-plugin-tailwindcss": "^0.8.0",
        "tailwindcss": "^4.3.0",
        "typescript": "^5.2.2",
        "typescript-eslint": "^8.23.0",
        "vite": "^7.0.4",
        "vue-tsc": "^2.2.4"
    },
    "dependencies": {
        "@bugsnag/browser-performance": "^3.4.1",
        "@bugsnag/js": "^8.9.0",
        "@bugsnag/plugin-vue": "^8.9.0",
        "@heroicons/vue": "^2.2.0",
        "@inertiajs/vue3": "^2.3.7",
        "@lucide/vue": "^1.29.0",
        "@vueuse/core": "^12.8.2",
        "class-variance-authority": "^0.7.1",
        "clsx": "^2.1.1",
        "dayjs": "^1.11.21",
        "laravel-vite-plugin": "^2.0.0",
        "leaflet": "^1.9.4",
        "lucide-vue-next": "^0.468.0",
        "playwright": "^1.62.1",
        "reka-ui": "^2.6.1",
        "tailwind-merge": "^3.2.0",
        "tw-animate-css": "^1.2.5",
        "vue": "^3.5.13",
        "vue-input-otp": "^0.3.2",
        "vue-tailwind-datepicker": "^1.7.4"
    },
    "optionalDependencies": {
        "@rollup/rollup-linux-x64-gnu": "4.9.5",
        "@rollup/rollup-win32-x64-msvc": "4.9.5",
        "@tailwindcss/oxide-linux-x64-gnu": "^4.0.1",
        "@tailwindcss/oxide-win32-x64-msvc": "^4.0.1",
        "lightningcss-linux-x64-gnu": "^1.29.1",
        "lightningcss-win32-x64-msvc": "^1.29.1"
    }
}
